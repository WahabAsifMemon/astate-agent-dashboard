# Used by: npm run build:staging
# Backend API the staging site talks to (no trailing slash)
VITE_API_URL=https://api.astateinsurance.com/a-state-backend/api

# Folder the app lives in: https://staging.astateinsurance.com/agent-portal/
# Must start and end with a slash. dist/.htaccess picks this up automatically.
VITE_BASE=/agent-portal/
