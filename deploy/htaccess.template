# A-State Agent Portal (React single-page app) on Apache / cPanel

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Filled in at build time from Vite's base (VITE_BASE), so it always matches the build
  RewriteBase __BASE__

  # Serve real files and folders as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every other path (/log, /approvals, /payouts …) loads the app, so refreshing a page works
  RewriteRule . index.html [L]
</IfModule>

# index.html must always be fresh so a new deploy shows up right away
<FilesMatch "^index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>

# Built JS/CSS have a hash in their name, so they can be cached for a long time
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
